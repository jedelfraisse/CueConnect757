@using Microsoft.AspNetCore.Components.Authorization
@inject UserInfoService UserInfoService

<AuthorizeView>
    <Authorized>
        <div class="user-avatar-container" @onfocusout="HandleFocusOut" tabindex="0">
            <div class="user-avatar" @onclick="ToggleDropdown">
                @GetInitials(context.User.Identity?.Name)
            </div>
            @if (showDropdown)
            {
                <div class="user-dropdown" @onclick:stopPropagation="true">
                    <a href="/account" @onclick="CloseDropdown">Profile</a>
                    <a href="/dashboard" @onclick="CloseDropdown">Dashboard</a>
                    <div class="dropdown-divider"></div>
                    <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="MicrosoftIdentity/Account/SignIn" class="btn-login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool showDropdown = false;

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private void HandleFocusOut()
    {
        // Small delay to allow click events to register
        Task.Delay(200).ContinueWith(_ => 
        {
            showDropdown = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "??";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}
