.user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.user-name {
    color: #fff;
    font-weight: 500;
}

.btn-login,
.btn-logout {
    padding: 0.5rem 1rem;
    border-radius: 0.25rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
}

.btn-login {
    background-color: #0d6efd;
    color: white;
    border: none;
}

.btn-login:hover {
    background-color: #0b5ed7;
    color: white;
}

.btn-logout {
    background-color: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-logout:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    color: white;
}
