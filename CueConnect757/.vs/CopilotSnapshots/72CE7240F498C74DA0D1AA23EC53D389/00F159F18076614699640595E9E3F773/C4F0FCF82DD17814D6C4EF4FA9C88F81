@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="user-info">
            <span class="user-name">@context.User.Identity?.Name</span>
            <a href="MicrosoftIdentity/Account/SignOut" class="btn-logout">Sign out</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="MicrosoftIdentity/Account/SignIn" class="btn-login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

