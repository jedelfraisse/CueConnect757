@page "/leagues"
@rendermode InteractiveServer
@using CueConnect757.DataSQL
@using CueConnect757.Services
@using Microsoft.EntityFrameworkCore
@inject CueConnectDbContext Db
@inject ApaSyncService ApaSyncService

<PageTitle>Leagues - CueConnect757</PageTitle>

<PageHeader Title="APA Leagues" Description="View APA league sessions, divisions, and schedules in Hampton Roads." />

<div class="main-content">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			@if (LastSyncTime.HasValue)
			{
				<small class="text-muted">
					Last updated: @FormatSyncTime(LastSyncTime.Value)
				</small>
			}
		</div>
		<button class="btn btn-primary" @onclick="SyncLeagueDataAsync" disabled="@IsSyncing">
			@if (IsSyncing)
			{
				<span class="spinner-border spinner-border-sm me-2"></span>
			}
			<i class="bi bi-arrow-repeat"></i> Sync Data
		</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(ErrorMessage))
	{
		<div class="alert alert-danger alert-dismissible fade show">
			<strong>Error:</strong> @ErrorMessage
			<button type="button" class="btn-close" @onclick="() => ErrorMessage = string.Empty"></button>
		</div>
	}

	@if (SyncResult is not null && SyncResult.Success)
	{
		<div class="alert alert-success alert-dismissible fade show">
			<strong>Success!</strong> Synced @SyncResult.SessionsSynced sessions, @SyncResult.DivisionsSynced divisions, @SyncResult.TeamsSynced teams, and @SyncResult.MatchesSynced matches.
			<button type="button" class="btn-close" @onclick="() => SyncResult = null"></button>
		</div>
	}

	@if (IsLoading)
	{
		<div class="text-center py-5">
			<div class="spinner-border text-primary" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
			<p class="mt-3 text-muted">Loading league data...</p>
		</div>
	}
	else if (Sessions.Count == 0)
	{
		<div class="alert alert-info">
			<h5><i class="bi bi-info-circle"></i> No Data Available</h5>
			<p>No APA league data has been synced yet. Click the "Sync Data" button to load the latest information.</p>
		</div>
	}
	else
	{
		<div class="sessions-container">
			@foreach (var session in Sessions)
			{
				<div class="session-card mb-4">
					<div class="session-header">
						<h3>@session.Name</h3>
						<div class="session-dates">
							<i class="bi bi-calendar-range"></i>
							@session.StartDate.ToString("MMM d, yyyy") - @session.EndDate.ToString("MMM d, yyyy")
						</div>
					</div>

					@if (session.Divisions.Any())
					{
						<div class="divisions-grid">
							@foreach (var division in session.Divisions.OrderBy(d => d.Name))
							{
								<div class="division-card">
									<div class="division-header">
										<h4>@division.Name</h4>
										<span class="badge bg-primary">@division.Teams.Count Teams</span>
									</div>

									@if (!string.IsNullOrWhiteSpace(division.Format))
									{
										<div class="division-info">
											<small class="text-muted">
												<i class="bi bi-trophy"></i> @division.Format
											</small>
										</div>
									}

									@if (!string.IsNullOrWhiteSpace(division.NightOfPlay))
									{
										<div class="division-info">
											<small class="text-muted">
												<i class="bi bi-calendar-week"></i> @division.NightOfPlay
											</small>
										</div>
									}

									@if (division.Teams.Any())
									{
										<div class="teams-list mt-3">
											<h6 class="text-muted mb-2">Teams:</h6>
											<ul class="list-unstyled">
												@foreach (var team in division.Teams.OrderBy(t => t.Name).Take(5))
												{
													<li>
														<i class="bi bi-people-fill"></i> @team.Name
														@if (!string.IsNullOrWhiteSpace(team.Number))
														{
															<span class="text-muted">(#@team.Number)</span>
														}
													</li>
												}
												@if (division.Teams.Count > 5)
												{
													<li class="text-muted">
														<small>+ @(division.Teams.Count - 5) more teams...</small>
													</li>
												}
											</ul>
										</div>
									}

									@if (division.Matches.Any())
									{
										<div class="mt-3">
											<small class="text-muted">
												<i class="bi bi-calendar-event"></i> @division.Matches.Count scheduled matches
											</small>
										</div>
									}
								</div>
							}
						</div>
					}
					else
					{
						<p class="text-muted">No divisions found for this session.</p>
					}
				</div>
			}
		</div>
	}
</div>

@code {
	private bool IsLoading { get; set; } = true;
	private bool IsSyncing { get; set; }
	private string ErrorMessage { get; set; } = string.Empty;
	private DateTime? LastSyncTime { get; set; }
	private ApaSyncResult? SyncResult { get; set; }
	private List<CueConnect757.DataSQL.Entities.Session> Sessions { get; set; } = [];

	protected override async Task OnInitializedAsync()
	{
		await LoadDataAsync();
	}

	private async Task LoadDataAsync()
	{
		IsLoading = true;
		ErrorMessage = string.Empty;

		try
		{
			Sessions = await Db.Sessions
				.Include(s => s.Divisions)
					.ThenInclude(d => d.Teams)
				.Include(s => s.Divisions)
					.ThenInclude(d => d.Matches)
				.OrderByDescending(s => s.StartDate)
				.ToListAsync();

			// Get the most recent sync time
			LastSyncTime = Sessions
				.Where(s => s.LastSyncedAt.HasValue)
				.Select(s => s.LastSyncedAt!.Value)
				.OrderByDescending(t => t)
				.FirstOrDefault();
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Failed to load league data: {ex.Message}";
		}
		finally
		{
			IsLoading = false;
		}
	}

	private async Task SyncLeagueDataAsync()
	{
		IsSyncing = true;
		ErrorMessage = string.Empty;
		SyncResult = null;

		try
		{
			SyncResult = await ApaSyncService.SyncLeagueAsync("southside");

			if (SyncResult.Success)
			{
				// Reload data from database
				await LoadDataAsync();
			}
			else
			{
				ErrorMessage = SyncResult.Message;
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Failed to sync: {ex.Message}";
		}
		finally
		{
			IsSyncing = false;
		}
	}

	private string FormatSyncTime(DateTime syncTime)
	{
		var elapsed = DateTime.UtcNow - syncTime;

		if (elapsed.TotalMinutes < 1)
			return "just now";
		if (elapsed.TotalMinutes < 60)
			return $"{(int)elapsed.TotalMinutes} minutes ago";
		if (elapsed.TotalHours < 24)
			return $"{(int)elapsed.TotalHours} hours ago";
		if (elapsed.TotalDays < 7)
			return $"{(int)elapsed.TotalDays} days ago";

		return syncTime.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
	}
}

