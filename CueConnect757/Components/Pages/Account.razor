@page "/account"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

<PageTitle>Account</PageTitle>

<h1>Account Information</h1>

<AuthorizeView>
    <Authorized>
        <div class="account-info">
            <h3>User Profile</h3>
            <table class="table">
                <tbody>
                    <tr>
                        <th>Name:</th>
                        <td>@GetClaim(ClaimTypes.Name)</td>
                    </tr>
                    <tr>
                        <th>Email:</th>
                        <td>@GetClaim(ClaimTypes.Email)</td>
                    </tr>
                    <tr>
                        <th>User ID:</th>
                        <td>@GetClaim(ClaimTypes.NameIdentifier)</td>
                    </tr>
                    <tr>
                        <th>Preferred Username:</th>
                        <td>@GetClaim("preferred_username")</td>
                    </tr>
                </tbody>
            </table>

            <h3>All Claims</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Claim Type</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in context.User.Claims.OrderBy(c => c.Type))
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td>@claim.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Please <a href="MicrosoftIdentity/Account/SignIn">sign in</a> to view your account information.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string GetClaim(string claimType)
    {
        if (AuthenticationStateTask == null)
            return "N/A";

        var authState = AuthenticationStateTask.Result;
        return authState.User.FindFirst(claimType)?.Value ?? "N/A";
    }
}
