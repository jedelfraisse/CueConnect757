@page "/findplayers"

<PageTitle>Find Players - CueConnect757</PageTitle>

<PageHeader Title="Player Directory & Search" Description="Connect with pool players in Hampton Roads. Find practice partners, teammates, or opponents." />

<div class="main-content">
    <p class="lead">
        Browse player ads and connect with others in the local billiards community.
    </p>

    <div class="content-placeholder">
        <h2>Player Ads & Directory</h2>
        <p>This page will feature:</p>
        <ul>
            <li>Browse "Player Looking for Team" ads</li>
            <li>Search by skill level, location, and availability</li>
            <li>Filter by league preference (APA, BCA, USAPL, In-House)</li>
            <li>Filter by night of play and location</li>
            <li>Player profiles with contact information</li>
            <li>Practice partner matching</li>
            <li>Private messaging between players</li>
            <li>Post your own player ad</li>
        </ul>
        <p class="note">
            <strong>APA Members:</strong> Link your APA account to display your official skill level and stats. 
            This is optional and only available to registered APA members who choose to connect their account.
        </p>
    </div>
</div>

<style>
    .lead {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 2rem;
    }

    .content-placeholder {
        background: #f8f9fa;
        border-left: 4px solid #08AFF2;
        padding: 2rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    .content-placeholder h2 {
        color: #08AFF2;
        margin-top: 0;
    }

    .content-placeholder ul {
        line-height: 1.8;
    }

    .content-placeholder .note {
        margin-top: 1.5rem;
        padding: 1rem;
        background: #d1ecf1;
        border-left: 4px solid #0c5460;
        border-radius: 4px;
        font-size: 0.95rem;
    }
</style>
